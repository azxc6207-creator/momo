# Google 試算表自動存檔設定範例。
# 本機：複製成 .streamlit/secrets.toml（已被 .gitignore 排除，不會上傳 GitHub）
# Streamlit Cloud：App → Settings → Secrets，貼上下面內容（換成你自己的值）
# 絕對不要把真正的金鑰提交到 GitHub。

[gsheet]
spreadsheet = "https://docs.google.com/spreadsheets/d/你的試算表ID/edit"

[gcp_service_account]
type = "service_account"
project_id = "你的專案ID"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxx@你的專案ID.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
